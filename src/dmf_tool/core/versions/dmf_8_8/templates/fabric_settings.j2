fabric-settings {{ fabric.fabric_settings.fabric_name }}
{% if fabric.fabric_settings.syslog_server %}
  syslog {{ fabric.fabric_settings.syslog_server }}
{% endif %}
{% if fabric.fabric_settings.ntp_server %}
  ntp {{ fabric.fabric_settings.ntp_server }}
{% endif %}
{% if fabric.fabric_settings.snmp_community %}
  snmp-community {{ fabric.fabric_settings.snmp_community | secret_value }}
{% endif %}
{% if fabric.fabric_settings.enable_password %}
  enable-password {{ fabric.fabric_settings.enable_password | secret_value }}
{% endif %}
{% if fabric.fabric_settings.api_token %}
  api-token {{ fabric.fabric_settings.api_token | secret_value }}
{% endif %}
exit
